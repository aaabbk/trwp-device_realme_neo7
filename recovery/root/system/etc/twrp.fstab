#
# twrp.fstab - realme Neo7 (RE6022L1 / MT6989 / Android 14)
#
# ============================================================================
# 【唯一依据】官方 vendor_boot.img 解包出的两份 fstab：
#   A = ramdisk/system/etc/recovery.fstab          （官方恢复模式用）
#   B = ramdisk/first_stage_ramdisk/fstab.mt6989   （第一段挂载用）
# 再用 1.txt 的实测分区表确认"哪些分区真实存在"。
# 不采用任何第三方设备树的分区表；每条都在行尾注明来源。
#
# 语法：<mount_point> <fstype> <device> [flags]
#   - 镜像/固件分区用 emmc 类型（TWRP 视为 image：可备份、可刷写）
#   - dynamic(logical) 分区带 logical,slotselect
#   - A/B 分区不写 _a/_b，由 slotselect 自动选择当前槽
#   - 原厂 A 有 /recovery 条目，但 1.txt 实测无 recovery 分区 → 不写
# ============================================================================
#

# ============================ 引导固件（A/B，可备份/可刷写）
/dev/block/by-name/boot /boot emmc defaults slotselect                                  # A/B
/dev/block/by-name/vendor_boot /vendor_boot emmc defaults slotselect                    # B
/dev/block/by-name/init_boot /init_boot emmc defaults slotselect                        # B
/dev/block/by-name/dtbo /dtbo emmc defaults slotselect                                  # A
/dev/block/by-name/vbmeta /vbmeta emmc defaults slotselect                              # A
/dev/block/by-name/vbmeta_system /vbmeta_system emmc defaults slotselect                # A
/dev/block/by-name/vbmeta_vendor /vbmeta_vendor emmc defaults slotselect                # A
/dev/block/by-name/lk /bootloader emmc defaults slotselect                              # A: lk → /bootloader
/dev/block/by-name/logo /logo emmc defaults slotselect                                  # A
/dev/block/by-name/preloader_raw /preloader emmc defaults slotselect                    # 1.txt: preloader_raw_a/b

# ============================ 安全/协处理器固件（A/B）
/dev/block/by-name/tee /tee emmc defaults slotselect                                    # A/B
/dev/block/by-name/gz /gz emmc defaults slotselect                                      # A/B
/dev/block/by-name/scp /scp emmc defaults slotselect                                    # A/B
/dev/block/by-name/sspm /sspm emmc defaults slotselect                                  # A/B
/dev/block/by-name/dpm /dpm emmc defaults slotselect                                    # A/B
/dev/block/by-name/mcupm /mcupm emmc defaults slotselect                                # A/B
/dev/block/by-name/ccu /ccu emmc defaults slotselect                                    # B
/dev/block/by-name/vcp /vcp emmc defaults slotselect                                    # B
/dev/block/by-name/gpueb /gpueb emmc defaults slotselect                                # B
/dev/block/by-name/spmfw /spmfw emmc defaults slotselect                                # A/B
/dev/block/by-name/ise /ise emmc defaults slotselect                                    # 1.txt
/dev/block/by-name/pvmfw /pvmfw emmc defaults slotselect                                # 1.txt

# ============================ 通信 / 其他固件（A/B）
/dev/block/by-name/modem /modem emmc defaults slotselect                                # B
/dev/block/by-name/mcf_ota /mcf_ota emmc defaults slotselect                            # B
/dev/block/by-name/audio_dsp /audio_dsp emmc defaults slotselect                        # B
/dev/block/by-name/pi_img /pi_img emmc defaults slotselect                              # B
/dev/block/by-name/apusys /apusys emmc defaults slotselect                              # 1.txt
/dev/block/by-name/mvpu_algo /mvpu_algo emmc defaults slotselect                        # B
/dev/block/by-name/connsys_wifi /connsys_wifi emmc defaults slotselect                  # B
/dev/block/by-name/connsys_bt /connsys_bt emmc defaults slotselect                      # B
/dev/block/by-name/connsys_gnss /connsys_gnss emmc defaults slotselect                  # 1.txt
/dev/block/by-name/cdt_engineering /cdt_engineering emmc defaults slotselect            # A

# ============================ 单份固件 / 校准数据（可备份、可刷写）
/dev/block/by-name/misc /misc emmc defaults defaults                                    # A
/dev/block/by-name/para /para emmc defaults defaults                                    # A
/dev/block/by-name/boot_para /boot_para emmc defaults defaults                          # B
/dev/block/by-name/dram_para /dram_para emmc defaults defaults                          # 1.txt
/dev/block/by-name/splash_odm /splash_odm emmc defaults defaults                        # 1.txt
/dev/block/by-name/sec1 /sec1 emmc defaults defaults                                    # 1.txt
/dev/block/by-name/frp /persistent emmc defaults defaults                               # A: frp → /persistent
/dev/block/by-name/nvram /nvram emmc defaults defaults                                  # A
/dev/block/by-name/proinfo /proinfo emmc defaults defaults                              # A
/dev/block/by-name/seccfg /seccfg emmc defaults defaults                                # A
/dev/block/by-name/ocdt /ocdt emmc defaults defaults                                    # 1.txt
/dev/block/by-name/otp /otp emmc defaults defaults                                      # A
/dev/block/by-name/expdb /expdb emmc defaults defaults                                  # A
/dev/block/by-name/pstore /pstore emmc defaults defaults                                # 1.txt
/dev/block/by-name/flashinfo /flashinfo emmc defaults defaults                          # 1.txt
/dev/block/by-name/mrdump /mrdump emmc defaults defaults                                # 1.txt
/dev/block/by-name/hybridswap /hybridswap emmc defaults defaults                        # 1.txt
/dev/block/by-name/nvdata /nvdata emmc defaults defaults                                # A/B
/dev/block/by-name/nvcfg /nvcfg emmc defaults defaults                                  # A/B
/dev/block/by-name/protect1 /protect1 emmc defaults defaults                            # A
/dev/block/by-name/protect2 /protect2 emmc defaults defaults                            # A
/dev/block/by-name/oplusreserve1 /oplusreserve1 emmc defaults defaults                  # 1.txt
/dev/block/by-name/oplusreserve3 /oplusreserve3 emmc defaults defaults                  # 1.txt
/dev/block/by-name/oplusreserve5 /oplusreserve5 emmc defaults defaults                  # 1.txt
/dev/block/by-name/oplusreserve6 /oplusreserve6 emmc defaults defaults                  # 1.txt

# ============================ super / 动态分区
/dev/block/by-name/super /super emmc defaults defaults                                  # 1.txt sdc91

/dev/block/by-name/system /system_root erofs ro wait,slotselect,logical                 # A/B
/dev/block/by-name/system /system_root ext4 ro wait,slotselect,logical
/dev/block/by-name/system_ext /system_ext erofs ro wait,slotselect,logical              # A/B
/dev/block/by-name/system_ext /system_ext ext4 ro wait,slotselect,logical
/dev/block/by-name/product /product erofs ro wait,slotselect,logical                    # A/B
/dev/block/by-name/product /product ext4 ro wait,slotselect,logical
/dev/block/by-name/vendor /vendor erofs ro wait,slotselect,logical                      # A/B
/dev/block/by-name/vendor /vendor ext4 ro wait,slotselect,logical
/dev/block/by-name/odm /odm erofs ro wait,slotselect,logical                            # A/B
/dev/block/by-name/odm /odm ext4 ro wait,slotselect,logical
/dev/block/by-name/vendor_dlkm /vendor_dlkm erofs ro wait,slotselect,logical            # A/B
/dev/block/by-name/odm_dlkm /odm_dlkm erofs ro wait,slotselect,logical                  # A/B
/dev/block/by-name/system_dlkm /system_dlkm erofs ro wait,slotselect,logical            # A/B

# my_* 分区由 overlay 叠加，TWRP 默认不挂载；需要时照格式追加（只读）

# ============================ 用户数据 / 元数据 / 缓存 / 持久化
/dev/block/by-name/userdata /data f2fs noatime,nosuid,nodev,discard,noflush_merge,fsync_mode=nobarrier wait,check,formattable   # A/B
/dev/block/by-name/metadata /metadata f2fs noatime,nosuid,nodev,discard wait                                                   # A/B
# ⚠ /cache 实际是 oplusreserve2（256 MiB，Oplus 保留区）：可挂载，不要格式化
/dev/block/by-name/oplusreserve2 /cache ext4 noatime,nosuid,nodev,noauto_da_alloc,discard wait,check   # A
/dev/block/by-name/persist /persist ext4 noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc wait # A/B

# ============================ 外置存储（照原厂写法）
/devices/platform/externdevice* auto auto defaults voldmanaged=sdcard1:auto              # A
/devices/platform/11200000.usb3_xhci* auto vfat defaults voldmanaged=usbotg:auto         # A
/devices/platform/soc/11201000.usb0/11200000.xhci* auto vfat defaults voldmanaged=usbotg:auto   # B
/devices/platform/soc/11211000.usb1/11210000.xhci* auto vfat defaults voldmanaged=usbotg:auto   # B
