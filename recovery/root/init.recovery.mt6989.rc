#
# init.recovery.mt6989.rc - realme Neo7 (RE6022L1 / MT6989)
#
# 原则：**能开机第一**。本文件只放 TWRP 启动/使用必须的设置，
# 任何"可选功能"（sideload OTA 的 HAL 等）都不在这里自动启动，
# 避免 init 解析/服务启动失败影响 recovery 启动。
#
# 模块加载不在这里写：原厂 270 个 .ko + modules.load.recovery 已随设备树
# 放进 ramdisk 的 /lib/modules，AOSP init 在 recovery 模式自动加载。
#

on init
    # ---------------- 显示 ----------------
    # 官方 ueventd.rc: /dev/graphics/* 0660 root graphics（TWRP minui 打开 fb0）
    chown root graphics /dev/graphics
    chmod 0770 /dev/graphics
    chown root graphics /dev/graphics/fb0
    chmod 0660 /dev/graphics/fb0

    # ---------------- 输入 ----------------
    chmod 0770 /dev/input
    chown root input /dev/input/*
    chmod 0660 /dev/input/*
    chmod 0660 /sys/devices/virtual/input/input*/enable
    chmod 0660 /sys/devices/virtual/input/input*/poll_delay

    # ---------------- 触摸驱动节点（Synaptics TCM2 / S3910，HBP 4.0）----------------
    chown system system /dev/tcm0
    chmod 0660 /dev/tcm0
    chown system system /dev/tcm_hbp0
    chmod 0660 /dev/tcm_hbp0
    chown system system /dev/hbp_core
    chmod 0660 /dev/hbp_core
    chown system system /dev/hbp0
    chmod 0660 /dev/hbp0
    chown system system /dev/hbp1
    chmod 0660 /dev/hbp1

on boot
    # TWRP 的 etc/init.rc 在 on init 里把 panic_on_oops 写成 1，
    # 这里在更晚的 on boot 覆盖回 0：模块异常时不要因 oops 直接重启，便于 adb 抓日志。
    # （本文件由 TWRP init.rc 第 6 行 import，同级 action 先于 TWRP 自身 on boot 执行）
    write /proc/sys/kernel/panic_on_oops 0

    # 显式拉起 adb：TWRP 的 init.rc 只在 ro.debuggable=1 时自动设 sys.usb.config，
    # 参考树（xiaomi yuechu）也是在这里显式设置，避免 adb 不可用。
    setprop sys.usb.config adb

on fs
    # ---------------- MTK 兼容路径 ----------------
    # TWRP 及 MTK 工具常用 /dev/block/bootdevice/by-name/... 路径；
    # 同时把 UFS boot LUN（实机 /dev/block/sda、sdb）映射成 mmcblk0boot0/1。
    # 与同平台参考树 xiaomi yuechu 的 init.recovery.mt6895.rc 一致。
    symlink /dev/block /dev/block/bootdevice
    symlink /dev/block/sda /dev/block/mmcblk0boot0
    symlink /dev/block/sdb /dev/block/mmcblk0boot1

    # ---------------- USB gadget ----------------
    # 实机 ls /sys/class/udc = "11201000.usb0  11211000.usb1"
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "11201000.usb0"

    # ---------------- OTG 供电（与官方 init.rc 一致）----------------
    write /sys/class/power_supply/usb/otg_switch 1
    write /sys/class/oplus_chg/usb/otg_switch 1

# ============================================================================
# 【可选】sideload 官方 A/B OTA 需要的服务（默认全部注释，保证能开机）
#
# 启用方法：把下面整段取消注释后重新构建。启用后：
#   1) servicemanager 提供 AIDL HAL 注册
#   2) vendor.boot-default 提供 IBootControl（OTA 写入后切换 slot）
#   3) vendor.health-default 提供电量（可选，不影响 OTA）
#
# 依赖文件已在设备树里：
#   system/bin/servicemanager
#   system/bin/hw/android.hardware.boot-service.mtk_recovery
#   system/bin/hw/android.hardware.health-service.example_recovery
#   system/lib64/ue_sideload/（28 个官方库，LD_LIBRARY_PATH 指向它）
#   system/bin/update_engine_sideload_real + sbin/update_engine_sideload（wrapper）
#
# 注意：若 TWRP 自带的 init.rc 已定义 servicemanager 服务，取消注释会因
#       duplicate service 报错，此时只取消 HAL 两段、把 servicemanager 段删掉。
#
# service servicemanager /system/bin/servicemanager
#     class core
#     user system
#     group system readproc
#     seclabel u:r:recovery:s0
#
# service vendor.boot-default /system/bin/hw/android.hardware.boot-service.mtk_recovery
#     class early_hal
#     user root
#     group root
#     environment LD_LIBRARY_PATH /system/lib64/ue_sideload
#     seclabel u:r:recovery:s0
#     interface aidl android.hardware.boot.IBootControl/default
#
# service vendor.health-default /system/bin/hw/android.hardware.health-service.example_recovery
#     class hal
#     user system
#     group system
#     capabilities WAKE_ALARM BLOCK_SUSPEND
#     environment LD_LIBRARY_PATH /system/lib64/ue_sideload
#     seclabel u:r:recovery:s0
#
# on boot
#     start servicemanager
#     start vendor.boot-default
#     start vendor.health-default
# ============================================================================
