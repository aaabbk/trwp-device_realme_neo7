#
# twrp.flags - realme Neo7 (RE6022L1 / MT6989)
#
# TWRP 12.1 在解析 fstab 后读取 /etc/twrp.flags。
# 格式：段首行为挂载点，随后以 flags= 开头的行给出分号分隔的 TWRP flags。
#
# 说明：
#   - 所有 fstype=emmc 的分区在 TWRP 的 Install Image 里都可刷写，flags 只控制
#     备份界面是否显示，以及显示名称。
#   - preloader / lk 只给 flashimg、不给 backup（刷错会变砖，不建议备份/回滚用）。
#   - 不要把 /cache（= oplusreserve2）标记 wipedata，那是 Oplus 保留区。
#

# ---------------- 引导/固件：备份列表里显示
/boot
    flags=display="Boot";backup=1;flashimg=1

/vendor_boot
    flags=display="Vendor Boot";backup=1;flashimg=1

/init_boot
    flags=display="Init Boot";backup=1;flashimg=1

/dtbo
    flags=display="DTBO";backup=1;flashimg=1

/vbmeta
    flags=display="VBMeta";backup=1;flashimg=1

/vbmeta_system
    flags=display="VBMeta System";backup=1;flashimg=1

/vbmeta_vendor
    flags=display="VBMeta Vendor";backup=1;flashimg=1

/modem
    flags=display="Modem";backup=1;flashimg=1

/logo
    flags=display="Logo";backup=1;flashimg=1

# ---------------- 危险分区：只允许刷写，不提供备份
/preloader
    flags=display="Preloader";flashimg=1

/lk
    flags=display="LK";flashimg=1

# ---------------- 数据/系统
/system_root
    flags=display="System"

/data
    flags=display="Data";wipeingui;wipedata

/metadata
    flags=display="Metadata"

/cache
    flags=display="Cache";wipeingui

/persist
    flags=display="Persist"
