#
# init.recovery.mt6989.rc - realme Neo7 (RE6022L1 / MT6989)
#
# 原则：**能开机第一**。本文件只放 TWRP 启动/使用必须的设置，
# 任何"可选功能"（sideload OTA 的 HAL 等）都不在这里自动启动，
# 避免 init 解析/服务启动失败影响 recovery 启动。
#
# 模块加载不在这里写：原厂 270 个 .ko + modules.load.recovery 已随设备树
# 放进 ramdisk 的 /lib/modules，AOSP init 在 recovery 模式自动加载。
#

on early-init
    # display/touch 模块异常时不要因 oops 直接重启，便于 adb 抓日志
    write /proc/sys/kernel/panic_on_oops 0

on init
    # ---------------- 显示 ----------------
    # 官方 ueventd.rc: /dev/graphics/* 0660 root graphics（TWRP minui 打开 fb0）
    chown root graphics /dev/graphics
    chmod 0770 /dev/graphics
    chown root graphics /dev/graphics/fb0
    chmod 0660 /dev/graphics/fb0

    # ---------------- 输入 ----------------
    chmod 0770 /dev/input
    chown root input /dev/input/*
    chmod 0660 /dev/input/*
    chmod 0660 /sys/devices/virtual/input/input*/enable
    chmod 0660 /sys/devices/virtual/input/input*/poll_delay

    # ---------------- 触摸驱动节点（Synaptics TCM2 / S3910，HBP 4.0）----------------
    chown system system /dev/tcm0
    chmod 0660 /dev/tcm0
    chown system system /dev/tcm_hbp0
    chmod 0660 /dev/tcm_hbp0
    chown system system /dev/hbp_core
    chmod 0660 /dev/hbp_core
    chown system system /dev/hbp0
    chmod 0660 /dev/hbp0
    chown system system /dev/hbp1
    chmod 0660 /dev/hbp1

on fs
    # ---------------- USB gadget ----------------
    # 实机 ls /sys/class/udc = "11201000.usb0  11211000.usb1"
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "11201000.usb0"

    # ---------------- OTG 供电（与官方 init.rc 一致）----------------
    write /sys/class/power_supply/usb/otg_switch 1
    write /sys/class/oplus_chg/usb/otg_switch 1
